--- !u!114 &1346276163
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1346276161}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d7e270f43288c0247a4da068c0f0bf0b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueText: {fileID: 1294661757}
  dialogueAudioSource: {fileID: 800932625}
  dialogueObjectsSnippets:
  - dialogueSentenceEnglish: 'The otaku blogs on this ship are pretty intense sometimes. '
    snippetVA: {fileID: 8300000, guid: aa5f794e33a5c7b41aa97d7ed0c929bb, type: 3}
    snippetTime: 4
  - dialogueSentenceEnglish: 'I used to read them from time to time, check to see
      whether Maki was mentioned. '
    snippetVA: {fileID: 8300000, guid: afa4c6c1c7c20e745898de7adb78eb71, type: 3}
    snippetTime: 5
  - dialogueSentenceEnglish: Just being protective.
    snippetVA: {fileID: 8300000, guid: e556361b8c471e14b9ae92600e22a0c4, type: 3}
    snippetTime: 3
  - dialogueSentenceEnglish: 'But now I know they''ll be talking about me, I can''t
      even bear to go online. '
    snippetVA: {fileID: 8300000, guid: f23fa2fe6130933459e43aa7bb54c00e, type: 3}
    snippetTime: 6
  currentSnippetIndex: 0
  isTesting: 0
