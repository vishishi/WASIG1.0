  m_Script: {fileID: 11500000, guid: 797c8bd9f9d1f0f459a048a05d813fe9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueText: {fileID: 809205627}
  characterNameText: {fileID: 0}
  dialogueAudioSource: {fileID: 0}
  characterPortrait: {fileID: 0}
  shikiSprite: {fileID: 0}
  makiSprite: {fileID: 0}
  dialogueSnippets:
  - dialogueSentenceEnglish: 'Pandas, everywhere. '
    snippetVA: {fileID: 8300000, guid: 067f233369edd0d4b94a91ffe5afbbb4, type: 3}
    snippetTime: 2
    characterName: Shiki
  - dialogueSentenceEnglish: 'I was worried it would be that thing where like, you
      admit you like something and everyone now associates you with that, forever. '
    snippetVA: {fileID: 8300000, guid: b31bd5521868f064f80aace965f5aa1c, type: 3}
    snippetTime: 8
    characterName: Shiki
  - dialogueSentenceEnglish: But Maki doesn't seem to get tired of the pandas, luckily.
    snippetVA: {fileID: 8300000, guid: f8248fd1bb040d443b22cad9730452e6, type: 3}
    snippetTime: 4
    characterName: Shiki
  currentSnippetIndex: 0
  isTesting: 0
