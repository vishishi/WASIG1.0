  makiSprite: {fileID: 0}
  dialogueSnippets:
  - dialogueSentenceEnglish: 'Miki''s books on idols. Of course, I haven''t read
      any. '
    snippetVA: {fileID: 8300000, guid: 16fba6d30ed741d4a9fdd6e79ee2f3ac, type: 3}
    snippetTime: 3
    characterName: 
  - dialogueSentenceEnglish: 'God, she''s been preparing for this her whole life
      and I''ve had like, 3 days?! '
    snippetVA: {fileID: 8300000, guid: f29a6ca9583ec3242bfaca85bdfa85dd, type: 3}
    snippetTime: 4
    characterName: 
  - dialogueSentenceEnglish: 'Fine. It''s fine. It has to be. '
    snippetVA: {fileID: 8300000, guid: f29a6ca9583ec3242bfaca85bdfa85dd, type: 3}
    snippetTime: 5
    characterName: 
  currentSnippetIndex: 0
  isTesting: 1
