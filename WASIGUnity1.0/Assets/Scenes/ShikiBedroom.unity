MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 244123607}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d7e270f43288c0247a4da068c0f0bf0b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueText: {fileID: 1569898601}
  dialogueAudioSource: {fileID: 800932625}
  dialogueObjectsSnippets:
  - dialogueSentenceEnglish: 'Maki''s books on idols. '
    snippetVA: {fileID: 8300000, guid: 164bba903e21a86439a730f117d56a3b, type: 3}
    snippetTime: 3
  - dialogueSentenceEnglish: 'Of course, I haven''t read any. '
    snippetVA: {fileID: 8300000, guid: 0d259ab5fd6d57f439ea003b60a0d485, type: 3}
    snippetTime: 3
  - dialogueSentenceEnglish: 'Oh stars, she''s been preparing for this her whole
      life and I''ve had like, 3 days?! '
    snippetVA: {fileID: 8300000, guid: b2b8240e139920f418fd51bca1659a4c, type: 3}
    snippetTime: 7
  - dialogueSentenceEnglish: 'Fine. It''s fine. '
    snippetVA: {fileID: 8300000, guid: 322d461a4bb62754bae82db081b609fe, type: 3}
    snippetTime: 2
  - dialogueSentenceEnglish: It has to be.
    snippetVA: {fileID: 8300000, guid: 085e59e3c3b187d4790b818ff5d23a53, type: 3}
    snippetTime: 3
  currentSnippetIndex: 0
  isTesting: 0
