--- !u!114 &1621075978
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1621075976}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 797c8bd9f9d1f0f459a048a05d813fe9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueText: {fileID: 0}
  characterNameText: {fileID: 0}
  dialogueAudioSource: {fileID: 0}
  characterPortrait: {fileID: 0}
  shikiSprite: {fileID: 0}
  makiSprite: {fileID: 0}
  dialogueSnippets:
  - dialogueSentenceEnglish: 'Idol Planet, Goto''s Garden.. '
    snippetVA: {fileID: 0}
    snippetTime: 3
    characterName: Shiki
  - dialogueSentenceEnglish: 'The otaku blogs on this ship are pretty intense sometimes. '
    snippetVA: {fileID: 8300000, guid: aa5f794e33a5c7b41aa97d7ed0c929bb, type: 3}
    snippetTime: 4
    characterName: Shiki
  - dialogueSentenceEnglish: 'I used to read them from time to time, check to see
      whether Maki was mentioned. '
    snippetVA: {fileID: 8300000, guid: afa4c6c1c7c20e745898de7adb78eb71, type: 3}
    snippetTime: 5
    characterName: Shiki
  - dialogueSentenceEnglish: 'Just being protective. '
    snippetVA: {fileID: 8300000, guid: e556361b8c471e14b9ae92600e22a0c4, type: 3}
    snippetTime: 3
    characterName: Shiki
  - dialogueSentenceEnglish: 'But now I know they''ll be talking about me, I can''t
      even bear to go online. '
    snippetVA: {fileID: 8300000, guid: f23fa2fe6130933459e43aa7bb54c00e, type: 3}
    snippetTime: 6
    characterName: Shiki
  currentSnippetIndex: 0
  isTesting: 1
