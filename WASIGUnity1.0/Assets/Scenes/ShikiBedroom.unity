--- !u!114 &1380369
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1380367}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d7e270f43288c0247a4da068c0f0bf0b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueText: {fileID: 868791570}
  dialogueAudioSource: {fileID: 800932625}
  dialogueObjectsSnippets:
  - dialogueSentenceEnglish: "If I go back to bed, I can pretend it's not concert
      day...\n "
    snippetVA: {fileID: 8300000, guid: 5531d16a198069041966a7d93ae77c87, type: 3}
    snippetTime: 5.5
  - dialogueSentenceEnglish: 'No, get up Shiki. You agreed to this. '
    snippetVA: {fileID: 8300000, guid: 14aa596f880de284fa1214aceb76f91a, type: 3}
    snippetTime: 3.3
  - dialogueSentenceEnglish: There's no turning back now.
    snippetVA: {fileID: 8300000, guid: 5f3bbb588322c9e4592716bb22aadcc7, type: 3}
    snippetTime: 2.5
  - dialogueSentenceEnglish: 'Fine. It''s fine. '
    snippetVA: {fileID: 8300000, guid: 322d461a4bb62754bae82db081b609fe, type: 3}
    snippetTime: 2
  - dialogueSentenceEnglish: It has to be.
    snippetVA: {fileID: 8300000, guid: 085e59e3c3b187d4790b818ff5d23a53, type: 3}
    snippetTime: 3
  currentSnippetIndex: 0
  isTesting: 0
